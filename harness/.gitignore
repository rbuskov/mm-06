# dsp-harness — only source, tests, pinned deps, and docs are committed.
.venv/
.work/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Generated render artifacts (the harness writes these into .work/, but guard
# against stray copies landing elsewhere under harness/).
*.wav
*.json
!references/*.wav

# Golden baselines ARE committed — that's the whole point of a golden (§9). The
# blessed metric-vector + render-hash JSON under goldens/ is the tracked
# baseline; only transient working renders (.work/) are ignored above.
!goldens/**/golden.json

# Regime-C overlay artifacts (render-vs-clip spectrogram / decay / pitch, §7).
# The PNGs are small and committed for the one human glance; the matplotlib-free
# curve-data fallback (overlay_data.json) is committed alongside them.
!goldens/**/overlays/overlay_data.json
